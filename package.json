{
  "name": "gold-market-observatory",
  "version": "0.1.0",
  "private": true,
  "description": "黄金市场观察站 - 轻量级黄金研究 Dashboard (Gold Market Observatory)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.scripts.json && node --test tests/*.test.cjs",
    "data:fetch": "tsc -p tsconfig.scripts.json && node .tmp-pipeline/scripts/fetch-data.js",
    "data:fetch:fred": "tsc -p tsconfig.scripts.json && node .tmp-pipeline/scripts/fetch-data.js --only fred",
    "data:inspect": "tsc -p tsconfig.scripts.json && node .tmp-pipeline/scripts/inspect-data.js",
    "data:check": "node scripts/check-data-quality.mjs",
    "data:changes": "node scripts/detect-substantive-data-change.mjs"
  },
  "dependencies": {
    "next": "^15.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "xlsx": "^0.18.5"
  }
}
