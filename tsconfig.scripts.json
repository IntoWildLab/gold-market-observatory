{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "outDir": ".tmp-pipeline",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] },
    "types": ["node"]
  },
  "include": ["scripts/fetch-data.ts", "scripts/fetch-event-risk.ts", "scripts/inspect-data.ts", "lib/**/*.ts", "types/**/*.ts", "components/design/EventRiskStrip.tsx"],
  "exclude": ["node_modules", "app"]
}
